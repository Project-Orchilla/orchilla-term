dsl Legio

Artifact(groupId = "software.orchilla", version = "1.0.0") ui
	Dsl("Konos", "13.6.12") > Builder(generationPackage = "box")

	Imports
		Test(groupId = "junit", artifactId = "junit", version = "4.13")
		Compile(groupId = "io.intino.alexandria", artifactId = "core-framework", version = "2.2.2")
		Compile(groupId = "io.intino.alexandria", artifactId = "logger4j", version = "1.1.0")
		Compile(groupId = "io.intino.alexandria", artifactId = "ui-framework", version = "6.7.22")
		Web(groupId = "software.orchilla", artifactId = "orchilla-ui", version = "1.0.0")
		Web(groupId = "software.orchilla", artifactId = "ui-elements", version = "1.0.0")
	Package(mode = ModulesAndLibrariesLinkedByManifest, finalName="ui") as Runnable(mainClass = "software.orchilla.ui.box.Main")
	Parameter(name = "port")
	Parameter(name="title")

    Distribution
        Artifactory("intino-maven")
			Release("https://artifactory.intino.io/artifactory/release-libraries")
			Snapshot("https://artifactory.intino.io/artifactory/snapshot-libraries")

RunConfiguration local
	Argument("port", "9004")
	Argument("title", "orchilla")